POSTGRES_USER=code2career
POSTGRES_PASSWORD=replace-with-a-strong-database-password
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
CODE_RUNNER_TOKEN=replace-with-a-second-random-secret-of-at-least-32-bytes
JWT_EXPIRATION_MS=86400000
CORS_ALLOWED_ORIGIN=https://app.example.com
BACKEND_PORT=8080
PASSWORD_RESET_CODE_EXPIRATION_MINUTES=10
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=replace-with-smtp-username
MAIL_PASSWORD=replace-with-smtp-password
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_SMTP_STARTTLS_REQUIRED=true
MAIL_FROM=no-reply@example.com
MANAGEMENT_HEALTH_MAIL_ENABLED=true
